# AI
.claude/

# Per-instance runtime state. The beetroot.yaml inside each instance
# directory CAN be committed if you want a reproducible config — but
# everything else (Android userdata, downloaded Frida binary, generated
# .env, mirrored Magisk modules) is local-only.
instances/*/data/
instances/*/modules/
instances/*/frida-server
instances/*/.env

# Registry of allocated instances. Generated by the CLI; not checked in
# because it pins host-specific port indices.
instances.json

# CLI download cache: frida-server binaries, magisk module zips. Local-only.
.cache/

# Python build artifacts
__pycache__/
*.pyc
*.egg-info/
.venv/
build/
dist/

# mkdocs build output
site/

# Coverage artifacts
.coverage
.coverage.*
coverage.xml
htmlcov/
