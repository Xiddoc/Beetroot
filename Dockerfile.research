# --- Stage 1: The Builder ---
FROM alpine:latest AS builder

# Install tools needed for downloading and decompressing
RUN apk add --no-cache curl xz

# 1. Download and decompress Frida Server
# Using v16.2.1 as requested
RUN curl -ks https://api.github.com/repos/frida/frida/releases/latest | grep "browser_download_url.*frida-server-.*-android-x86_64.xz" | cut -d : -f 2,3 | tr -d \" | xargs curl -LO && \
    xz -d frida-server-*.xz && \
    mv frida-server-* /frida-server

# 2. Get a static sqlite3 binary
# Standard Linux sqlite3 won't work on Android due to library differences (Bionic vs Glibc)
# We download a known-working static build for Android/x86_64
RUN curl -L https://github.com/tommccracken/sqlite3-static-bins/raw/master/x86_64/sqlite3 -o /sqlite3-static

# --- Stage 2: The Final Research Image ---
FROM redroid/redroid:14.0.0_litegapps_houdini_magisk

# We use --chmod=755 to set permissions without needing a shell/RUN
COPY --chmod=755 --from=builder /frida-server /system/bin/frida-server
COPY --chmod=755 --from=builder /sqlite3-static /system/bin/sqlite3

# Copy the entrypoint with executable permissions
COPY --chmod=755 entrypoint.sh /entrypoint.sh

# No USER or RUN commands here. 
# Android defaults to UID 0 (root) automatically.
ENTRYPOINT ["/entrypoint.sh"]

