# Use the image generated by redroid-script
FROM redroid/redroid:14.0.0-mindthegapps-ndk-magisk-widevine

USER root

# Install tools for headless config
RUN apt-get update && apt-get install -y sqlite3 xz-utils && rm -rf /var/lib/apt/lists/*

# Pre-install Frida Server
ADD https://github.com/frida/frida/releases/download/16.2.1/frida-server-16.2.1-android-x86_64.xz /system/bin/frida-server.xz
RUN xz -d /system/bin/frida-server.xz && \
    chmod 755 /system/bin/frida-server

# Copy automation entrypoint
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]

